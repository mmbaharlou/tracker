<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS in front of the two services (URL Rewrite + ARR with proxy enabled):
    - data sent by sites (v1|health) goes straight to the ASP.NET Core API on 127.0.0.1:{API_PORT}
    - everything else (the panel, and /api through its Next.js proxy) goes to Next.js on 127.0.0.1:{WEB_PORT}
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ACME challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>
        <rule name="HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTPS}" pattern="off" ignoreCase="true" /></conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Ingest to API" stopProcessing="true">
          <match url="^(v1|health)(/.*)?$" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:{API_PORT}/{R:0}" />
        </rule>
        <rule name="Panel" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:{WEB_PORT}/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security><requestFiltering removeServerHeader="true"><requestLimits maxAllowedContentLength="8388608" /></requestFiltering></security>
    <httpProtocol><customHeaders><remove name="X-Powered-By" /></customHeaders></httpProtocol>
  </system.webServer>
</configuration>
